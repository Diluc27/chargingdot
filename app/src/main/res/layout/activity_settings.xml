<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_service_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/status_checking"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_open_accessibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/btn_enable_service" />
        </LinearLayout>

        <!-- Setup Help Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_help_title"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_app_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/btn_app_info" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/desc_app_info"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_battery_optimization"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/btn_battery_opt" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/desc_battery_opt"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Dot Calibration Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/calibration_title"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Corner selection -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/corner_title"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rg_corner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_top_left"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="@string/corner_top_left" />

                <RadioButton
                    android:id="@+id/rb_top_right"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/corner_top_right" />
            </RadioGroup>

            <!-- Size -->
            <TextView
                android:id="@+id/tv_size_val"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                tools:text="Size: 4.0 dp" />

            <SeekBar
                android:id="@+id/sb_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="50"
                android:progress="10" />

            <!-- X Offset -->
            <TextView
                android:id="@+id/tv_offset_x_val"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                tools:text="Horizontal Offset (X): 16.3 dp" />

            <SeekBar
                android:id="@+id/sb_offset_x"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="800"
                android:progress="163" />

            <!-- Y Offset -->
            <TextView
                android:id="@+id/tv_offset_y_val"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                tools:text="Vertical Offset (Y): 24.5 dp" />

            <SeekBar
                android:id="@+id/sb_offset_y"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="800"
                android:progress="245" />

            <!-- Color below threshold -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/color_low_title" />

            <Spinner
                android:id="@+id/sp_color_low"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <!-- Threshold Percent -->
            <TextView
                android:id="@+id/tv_threshold_val"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                tools:text="Threshold: 90%" />

            <SeekBar
                android:id="@+id/sb_threshold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="50"
                android:progress="40" />

            <!-- Color at/above threshold -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/color_high_title" />

            <Spinner
                android:id="@+id/sp_color_high"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <!-- Reset button -->
            <Button
                android:id="@+id/btn_reset_defaults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/btn_reset_defaults" />
        </LinearLayout>

        <!-- Fake AOD Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/warning_card_background"
            android:orientation="vertical"
            android:padding="16dp">

            <Switch
                android:id="@+id/sw_fake_aod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fake_aod_title"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/fake_aod_warning"
                android:textColor="#FFAA00"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_brightness_val"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                tools:text="Fake AOD Brightness: 60%" />

            <SeekBar
                android:id="@+id/sb_brightness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="90"
                android:progress="50" />
        </LinearLayout>

        <!-- Footer -->
        <TextView
            android:id="@+id/tv_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            tools:text="Charging Dot • io.github.diluc27.chargingdot"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
