    <string name="setup_help_title">Setup Help</string>
    <string name="btn_app_info">App Info (Allow Restricted Settings)</string>
    <string name="desc_app_info">On Android 13+, tap the 3 dots in the top-right of App Info and tap \'Allow restricted settings\' if accessibility is greyed out.</string>
    <string name="btn_battery_opt">Battery Optimization Settings</string>
    <string name="desc_battery_opt">Set battery to Unrestricted so Android does not kill the dot indicator in the background.</string>

